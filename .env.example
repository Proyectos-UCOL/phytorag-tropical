# Configuración de Variables de Entorno - PhytoRAG-Tropical
# Copia este archivo como .env: cp .env.example .env

# 1. API de Google Gemini (Gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# 2. OpenRouter API (Para evaluación multi-modelo con GPT-4o, Claude, etc.)
# Solicita esta clave al Dr. Carlos Flores para la fase de benchmark de pago.
OPENROUTER_API_KEY=tu_api_key_de_openrouter_aqui

# 3. Configuración del Servidor
HOST=0.0.0.0
PORT=8000
